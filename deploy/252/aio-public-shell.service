[Unit]
Description=AIO public plugin shell
After=network-online.target aio-plugin-supervisor.service
Wants=network-online.target aio-plugin-supervisor.service

[Service]
Type=simple
User=aio-shell
Group=aio-shell
WorkingDirectory=/opt/aio-public-shell/current
EnvironmentFile=-/opt/aio-public-shell/runtime.env
Environment=AIO_WEB_HOST=127.0.0.1
Environment=AIO_WEB_PORT=3080
Environment=AIO_WEB_DIST=/opt/aio-public-shell/current/web
Environment=AIO_CONFIG=/opt/aio-public-shell/current/aio.toml
Environment=AIO_PLUGIN_CACHE=/opt/aio-public-shell/plugin-cache
Environment=AIO_PLUGIN_SUPERVISOR_SOCKET=/run/aio-plugin-supervisor/supervisor.sock
Environment=AIO_SESSION_SECURE=1
Environment=AIO_PASSWORD_MIN_LENGTH=8
ExecStart=/opt/aio-public-shell/current/aio-public-shell
TimeoutStartSec=300
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
